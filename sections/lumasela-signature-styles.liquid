{{ 'lumasela-home-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lumasela-home-sections.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign section_alt = section.settings.product_alt_text | default: section.settings.heading
-%}

<section
  id="signature-styles"
  class="lumasela-section lumasela-signature-styles color-{{ section.settings.color_scheme }} gradient"
  aria-labelledby="LumaselaSignatureStyles-{{ section.id }}"
>
  <div class="page-width lumasela-signature-styles__inner">
    <header class="lumasela-section-heading lumasela-section-heading--split">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="lumasela-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 id="LumaselaSignatureStyles-{{ section.id }}" class="lumasela-display lumasela-display--section">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}
      </div>
      {%- if section.settings.text != blank -%}
        <div class="lumasela-section-heading__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </header>

    <lumasela-home-rail>
    <div class="lumasela-signature-styles__grid" role="list" data-home-track>
      {%- for block in section.blocks -%}
        {%- liquid
          assign preview_alt = section.settings.product_image.alt | default: section_alt
          assign signature_label = block.settings.style_label | append: ': ' | append: block.settings.preview_name
        -%}
        <article
          class="lumasela-signature-card"
          role="listitem"
          style="--lumasela-signature-color: {{ block.settings.signature_color }}; --lumasela-signature-scale: {{ block.settings.signature_scale | divided_by: 100.0 }};"
          {{ block.shopify_attributes }}
        >
          <a class="lumasela-signature-card__link" href="{{ section.settings.product_link | default: routes.root_url }}">
          <div class="lumasela-signature-card__visual{% if block.settings.preview_asset == 'editable' %} lumasela-signature-card__visual--editable{% endif %}">
            {%- if block.settings.preview_asset == 'editable' -%}
              <img
                class="lumasela-signature-card__image"
                src="{{ 'lumasela-preview-phone-burgundy-base.webp' | asset_url }}"
                alt="Burgundy phone beneath a transparent clear case"
                width="1254"
                height="1254"
                loading="lazy"
              >
            {%- elsif block.settings.preview_asset != blank -%}
              <img
                class="lumasela-signature-card__image"
                src="{{ block.settings.preview_asset | asset_url }}"
                alt="{{ block.settings.style_label | escape }} signature shown on a burgundy phone"
                width="1024"
                height="1024"
                loading="lazy"
              >
            {%- elsif section.settings.product_image != blank -%}
              {{
                section.settings.product_image
                | image_url: width: 1200
                | image_tag:
                  widths: '360, 540, 720, 960, 1200',
                  sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw',
                  loading: 'lazy',
                  alt: preview_alt,
                  class: 'lumasela-signature-card__image'
              }}
            {%- else -%}
              <img
                class="lumasela-signature-card__image"
                src="{{ 'lumasela-iphone18pro-silver-clear-standard-v1.jpg' | asset_url }}"
                alt="{{ preview_alt | escape }}"
                width="1024"
                height="1024"
                loading="lazy"
              >
            {%- endif -%}
            {%- if block.settings.preview_asset == blank or block.settings.preview_asset == 'editable' -%}<span
              class="lumasela-signature-card__signature lumasela-signature-card__signature--{{ block.settings.style_label | handleize }}"
              data-position="{{ block.settings.position }}"
              aria-hidden="true"
            >
              {{ block.settings.preview_name | escape }}
            </span>{%- endif -%}
            <span class="visually-hidden">{{ signature_label | escape }}</span>
          </div>
          <div class="lumasela-signature-card__content">
            <p class="lumasela-signature-card__index">{{ forloop.index | prepend: '0' }}</p>
            <p class="lumasela-signature-card__meta">{{ block.settings.style_label | escape }}</p>
            <h3 class="lumasela-signature-card__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <div class="lumasela-signature-card__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
            <span class="lumasela-signature-card__cta">{{ section.settings.link_label | escape }} <span aria-hidden="true">↗</span></span>
          </div>
          </a>
        </article>
      {%- endfor -%}
    </div>
    <div class="lumasela-home-rail__feedback"><span>{{ section.settings.swipe_label | escape }}</span><output data-home-position>1 / {{ section.blocks.size }}</output></div>
    </lumasela-home-rail>
    {%- if section.settings.concept_note != blank -%}<p class="lumasela-home-concept-note">{{ section.settings.concept_note | escape }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Lumasela signature styles",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE SIGNATURE EDIT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Six ways to make it yours."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Compare the rhythm, weight and personality of every signature before you customize.</p>"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product image"
    },
    {
      "type": "text",
      "id": "product_alt_text",
      "label": "Product image alt text",
      "default": "Silver phone in a clear personalized case"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "url",
      "id": "product_link",
      "label": "Product link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Card link label",
      "default": "Explore this font"
    },
    {
      "type": "text",
      "id": "swipe_label",
      "label": "Mobile swipe hint",
      "default": "Swipe to explore the fonts"
    },
    {
      "type": "text",
      "id": "concept_note",
      "label": "Image disclosure"
    }
  ],
  "blocks": [
    {
      "type": "signature",
      "name": "Signature style",
      "settings": [
        {
          "type": "select",
          "id": "preview_asset",
          "label": "Signature preview image",
          "options": [
            {
              "value": "editable",
              "label": "Editable name on burgundy phone"
            },
            {
              "value": "font-allura-burgundy-horizontal.jpg",
              "label": "Allura"
            },
            {
              "value": "font-dancing-script-burgundy-horizontal.jpg",
              "label": "Dancing Script"
            },
            {
              "value": "font-great-vibes-burgundy-horizontal.jpg",
              "label": "Great Vibes"
            },
            {
              "value": "font-sacramento-burgundy-horizontal.jpg",
              "label": "Sacramento"
            },
            {
              "value": "font-kaushan-script-burgundy-horizontal.jpg",
              "label": "Kaushan Script"
            },
            {
              "value": "font-knewave-burgundy-horizontal.jpg",
              "label": "Knewave"
            }
          ]
        },
        {
          "type": "text",
          "id": "style_label",
          "label": "Style label",
          "default": "Allura"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Allura"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Connected and soft, designed for an effortless everyday mark.</p>"
        },
        {
          "type": "text",
          "id": "preview_name",
          "label": "Preview name",
          "default": "Aina"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Signature form",
          "options": [
            {
              "value": "flow",
              "label": "Flow"
            },
            {
              "value": "line",
              "label": "Line"
            },
            {
              "value": "note",
              "label": "Note"
            },
            {
              "value": "mark",
              "label": "Mark"
            }
          ],
          "default": "flow"
        },
        {
          "type": "select",
          "id": "position",
          "label": "Position",
          "options": [
            {
              "value": "lower-left",
              "label": "Lower left"
            },
            {
              "value": "lower-center",
              "label": "Lower center"
            },
            {
              "value": "lower-right",
              "label": "Lower right"
            }
          ],
          "default": "lower-right"
        },
        {
          "type": "color",
          "id": "signature_color",
          "label": "Signature color",
          "default": "#151515"
        },
        {
          "type": "range",
          "id": "signature_scale",
          "label": "Signature scale",
          "min": 70,
          "max": 120,
          "step": 5,
          "unit": "%",
          "default": 100
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lumasela signature styles",
      "blocks": [
        {
          "type": "signature",
          "settings": {
            "preview_asset": "editable",
            "style_label": "Allura",
            "title": "Allura",
            "preview_name": "Aina",
            "position": "lower-center",
            "signature_color": "#ffffff"
          }
        },
        {
          "type": "signature",
          "settings": {
            "preview_asset": "editable",
            "style_label": "Dancing Script",
            "title": "Dancing Script",
            "preview_name": "Aina",
            "position": "lower-center",
            "signature_color": "#ffffff"
          }
        },
        {
          "type": "signature",
          "settings": {
            "preview_asset": "editable",
            "style_label": "Great Vibes",
            "title": "Great Vibes",
            "preview_name": "Aina",
            "position": "lower-center",
            "signature_color": "#ffffff"
          }
        },
        {
          "type": "signature",
          "settings": {
            "preview_asset": "editable",
            "style_label": "Sacramento",
            "title": "Sacramento",
            "preview_name": "Aina",
            "position": "lower-center",
            "signature_color": "#ffffff"
          }
        },
        {
          "type": "signature",
          "settings": {
            "preview_asset": "editable",
            "style_label": "Kaushan Script",
            "title": "Kaushan Script",
            "preview_name": "Aina",
            "position": "lower-center",
            "signature_color": "#ffffff"
          }
        },
        {
          "type": "signature",
          "settings": {
            "preview_asset": "editable",
            "style_label": "Knewave",
            "title": "Knewave",
            "preview_name": "Aina",
            "position": "lower-center",
            "signature_color": "#ffffff"
          }
        }
      ]
    }
  ]
}
{% endschema %}
