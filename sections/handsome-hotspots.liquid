<section class="hs-section hs-hotspots" id="hs-hotspots-{{ section.id }}">
  <div class="page-width">
    <div class="hs-section-head"><div><p class="hs-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div></div>
    <div class="hs-hotspots__stage">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', alt: section.settings.image.alt, widths: '750,1100,1500,1800' }}
      {% else %}
        <img src="{{ 'handsome-demo-shoe.png' | asset_url }}" width="1254" height="1254" loading="lazy" alt="Original demonstration sneaker">
      {% endif %}
      {% for block in section.blocks %}
        <details class="hs-hotspot" style="--hotspot-x:{{ block.settings.x }}%;--hotspot-y:{{ block.settings.y }}%" {{ block.shopify_attributes }}>
          <summary aria-label="{{ block.settings.title | escape }}">+</summary>
          <div><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.copy | escape }}</p></div>
        </details>
      {% endfor %}
    </div>
    <p class="hs-hotspots__note">{{ section.settings.note | escape }}</p>
  </div>
</section>
{% schema %}
{
  "name":"Handsome hotspots",
  "settings":[
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE DETAILS"},
    {"type":"text","id":"heading","label":"Heading","default":"A closer look"},
    {"type":"text","id":"note","label":"Footnote","default":"Illustrative image. Product details are maintained on each product page."}
  ],
  "blocks":[{"type":"point","name":"Hotspot","settings":[
    {"type":"range","id":"x","label":"Horizontal position","min":5,"max":95,"step":1,"unit":"%","default":50},
    {"type":"range","id":"y","label":"Vertical position","min":5,"max":95,"step":1,"unit":"%","default":50},
    {"type":"text","id":"title","label":"Title","default":"Design detail"},
    {"type":"text","id":"copy","label":"Description","default":"Edit this note to match the actual product."}
  ]}],
  "max_blocks":4,
  "presets":[{"name":"Handsome hotspots","blocks":[{"type":"point"},{"type":"point"}]}]
}
{% endschema %}
