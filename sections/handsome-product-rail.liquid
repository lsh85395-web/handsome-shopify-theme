{% liquid
  assign rail_collection = section.settings.collection
  if rail_collection == blank
    assign rail_collection = collections['all']
  endif
%}
<section class="hs-section hs-product-rail" id="hs-rail-{{ section.id }}">
  <div class="page-width">
    <div class="hs-section-head">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="hs-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h2>{{ section.settings.heading | escape }}</h2>
        {% if section.settings.intro != blank %}<p>{{ section.settings.intro | escape }}</p>{% endif %}
      </div>
      {% if section.settings.show_view_all and rail_collection != blank %}<a class="hs-text-link" href="{{ rail_collection.url }}">View all <span aria-hidden="true">↗</span></a>{% endif %}
    </div>
    {% if rail_collection != blank and rail_collection.products_count > 0 %}
      <div class="hs-rail" role="list">
        {% for rail_product in rail_collection.products limit: section.settings.limit %}
          <article class="hs-product-card" role="listitem">
            <a class="hs-product-card__image" href="{{ rail_product.url }}">
              {% if rail_product.featured_media != blank %}
                {{ rail_product.featured_media | image_url: width: 800 | image_tag: loading: 'lazy', alt: rail_product.featured_media.alt, widths: '360,540,800' }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'hs-placeholder' }}
              {% endif %}
              {% unless rail_product.available %}<span class="hs-product-card__badge">Sold out</span>{% endunless %}
            </a>
            <div class="hs-product-card__info">
              <h3><a href="{{ rail_product.url }}">{{ rail_product.title | escape }}</a></h3>
              <span>{{ rail_product.price | money }}</span>
            </div>
            {% if rail_product.type != blank %}<p class="hs-product-card__type">{{ rail_product.type | escape }}</p>{% endif %}
          </article>
        {% endfor %}
      </div>
    {% else %}
      <p class="hs-empty">Add products to a Shopify collection, then choose it in this section.</p>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name":"Handsome product rail",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow"},
    {"type":"text","id":"heading","label":"Heading","default":"Find your pair"},
    {"type":"text","id":"intro","label":"Introduction"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"limit","label":"Products","min":2,"max":12,"step":1,"default":6},
    {"type":"checkbox","id":"show_view_all","label":"Show collection link","default":true}
  ],
  "presets":[{"name":"Handsome product rail"}]
}
{% endschema %}
