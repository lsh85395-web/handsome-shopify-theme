{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign product_form_id = 'LumaselaSoftProductForm-' | append: section.id
-%}
<section id="lumasela-product-main" class="product-shell" data-lumasela-product data-product-id="{{ product.id }}">
<script type="application/json" data-product-config>
