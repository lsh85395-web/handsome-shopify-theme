<script src="{{ 'lumasela-soft-product.js' | asset_url }}" defer></script>
{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign product_form_id = 'LumaselaSoftProductForm-' | append: section.id
  assign displayed_description = product.description
  if product.id == 15562989830432
    assign old_model_sentence = 'Select your exact model at checkout — including popular iPhone 17 / 17 Pro / 17 Pro Max / iPhone Air fits listed in the store, plus additional sizes as inventory expands.'
    assign current_model_sentence = 'lumasela_soft.product.current_model_guidance' | t
    assign displayed_description = displayed_description | replace: old_model_sentence, current_model_sentence
  endif
-%}
<section id="lumasela-product-main" class="product-shell product-shell--refined" data-lumasela-product data-product-id="{{ product.id }}">
<script type="application/json" data-product-config>
