{%- liquid
  case section.settings.fallback_visual
    when 'desk'
      assign fallback_image = 'lumasela-desk-lifestyle-iphone18pro-silver-clear-v1.jpg'
    when 'city'
      assign fallback_image = 'lumasela-city-lifestyle-iphone18pro-lumasela-v3.jpg'
    else
      assign fallback_image = 'lumasela-detail-macro-v1.jpg'
  endcase
  assign image_alt = section.settings.image.alt | default: section.settings.image_alt_text | default: section.settings.heading | strip_html

  if section.settings.height == 'medium'
    assign detail_height = '68rem'
  else
    assign detail_height = '82rem'
  endif

  if section.settings.content_position == 'right'
    assign content_justification = 'flex-end'
  else
    assign content_justification = 'flex-start'
  endif

  if section.settings.text_tone == 'dark'
    assign detail_color = 'var(--lumasela-ink)'
  else
    assign detail_color = '#fff'
  endif
-%}

<section
  id="lumasela-product-details"
  class="lumasela-detail-banner"
  style="min-height: {{ detail_height }}; color: {{ detail_color }};"
>
  <picture class="lumasela-detail-banner__media">
    {%- if section.settings.mobile_image != blank -%}
      <source
        media="(max-width: 749px)"
        srcset="
          {{ section.settings.mobile_image | image_url: width: 600 }} 600w,
          {{ section.settings.mobile_image | image_url: width: 900 }} 900w,
          {{ section.settings.mobile_image | image_url: width: 1200 }} 1200w
        "
        sizes="100vw"
      >
    {%- endif -%}

    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2200
        | image_tag:
          widths: '750, 1100, 1500, 1800, 2200',
          sizes: '100vw',
          class: 'lumasela-detail-banner__image',
          loading: 'lazy',
          alt: image_alt
      }}
    {%- else -%}
      <img
        class="lumasela-detail-banner__image"
        src="{{ fallback_image | asset_url }}"
        width="1672"
        height="941"
        loading="lazy"
        alt="{{ image_alt | escape }}"
      >
    {%- endif -%}
  </picture>

  <div
    class="lumasela-detail-banner__overlay"
    style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
    aria-hidden="true"
  ></div>
  <div
    class="lumasela-detail-banner__content page-width"
    style="min-height: {{ detail_height }}; justify-content: {{ content_justification }};"
  >
    <div class="lumasela-detail-banner__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="lumasela-kicker">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="lumasela-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="lumasela-copy rte" style="color: inherit;">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="lumasela-link lumasela-link--solid" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lumasela detail banner",
  "tag": "section",
  "class": "section-lumasela-detail-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "image_alt_text",
      "label": "Image alt text",
      "default": "Close-up of a clear case around a silver phone's camera corner"
    },
    {
      "type": "select",
      "id": "fallback_visual",
      "label": "Built-in fallback visual",
      "options": [
        { "value": "detail", "label": "Hand detail" },
        { "value": "desk", "label": "Desk" },
        { "value": "city", "label": "City" }
      ],
      "default": "detail"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "PRODUCT DETAIL"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Clear edges, the phone's original finish, and your signature in one frame."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Use this space for verified material, print, fit, button, and camera details.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View the product"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Section height",
      "options": [
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_tone",
      "label": "Text tone",
      "options": [
        { "value": "dark", "label": "Dark text" },
        { "value": "light", "label": "Light text" }
      ],
      "default": "light"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 35
    }
  ],
  "presets": [
    {
      "name": "Lumasela detail banner"
    }
  ]
}
{% endschema %}
