{{ 'lumasela-preview-styles.css' | asset_url | stylesheet_tag }}
{{ 'lumasela-product-interactions.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lumasela-preview-product.js' | asset_url }}" defer></script>
{%- assign selected_variant = product.selected_or_first_available_variant -%}
{%- liquid
  assign concept_product = false
  if product == blank or product.tags contains 'demo-product'
    assign concept_product = true
  endif
-%}
{%- assign preview_main_image = 'lumasela-preview-phone-silver-base.webp' | asset_url -%}
{%- if product.featured_media.preview_image != blank -%}
  {%- assign preview_main_image = product.featured_media.preview_image | image_url: width: 1400 -%}
{%- endif -%}
<section class="lumasela-preview-product" data-lumasela-product data-product-id="{{ product.id | default: 'preview' }}" data-concept-product="{{ concept_product }}" data-saved-options-message="{{ 'lumasela_product.saved_options' | t }}" id="overview">
  <div class="product-subnav" data-product-subnav aria-hidden="true" inert>
    <div class="page-width">
      <strong>{{ product.title | default: section.settings.demo_title | escape }}</strong>
      <nav aria-label="Product sections"><a href="#overview">Overview</a><a href="#personalise">Personalise</a><a href="#details">Details</a></nav>
    </div>
  </div>
  <div class="product-main page-width" data-product-main>
    <div class="product-gallery" data-product-gallery>
      <div class="product-gallery-main{% if concept_product %} is-personalisation-preview{% endif %}" data-gallery-main-wrap>
        {%- if concept_product -%}<span class="demo-chip">{{ 'lumasela_product.concept' | t }}</span>{%- endif -%}
        <img data-gallery-main src="{{ preview_main_image }}" alt="{{ product.featured_media.alt | default: product.title | escape }}" width="1024" height="1024" fetchpriority="high">
        {%- if concept_product -%}<div class="signature-safe-zone"><span class="product-inline-signature signature-allura position-bottom-center signature-size-medium" data-signature-live data-signature-positioned aria-live="polite">Aina</span></div>{%- endif -%}
        <button class="lumasela-gallery-zoom" type="button" data-gallery-zoom aria-label="{{ 'lumasela_product.zoom' | t }}">{{ 'lumasela_product.zoom' | t }} ↗</button>
      </div>
      <div class="product-thumbs" aria-label="{{ 'lumasela_product.images' | t }}">
        <button type="button" class="is-active" aria-pressed="true" data-gallery-src="{{ preview_main_image }}" {% if concept_product %}data-personalisation-preview{% endif %}><img src="{{ preview_main_image }}" alt="{{ product.featured_media.alt | default: product.title | escape }}" width="120" height="120"></button>
        {%- for media in product.media -%}
          {%- unless media.id == product.featured_media.id -%}
            <button type="button" aria-pressed="false" data-gallery-src="{{ media.preview_image | image_url: width: 1600 }}" data-gallery-alt="{{ media.alt | default: product.title | escape }}"><img src="{{ media.preview_image | image_url: width: 160 }}" alt="{{ media.alt | default: product.title | escape }}" width="120" height="120" loading="lazy"></button>
          {%- endunless -%}
        {%- endfor -%}
        {%- if concept_product -%}
          {%- assign concept_assets = 'lumasela-p02-gallery-clear-overview.webp,lumasela-p03-gallery-signature-closeup.webp,lumasela-p04-gallery-camera-overview.webp,lumasela-p05-gallery-customization.webp,lumasela-p06-gallery-everyday.webp' | split: ',' -%}
          {%- for asset in concept_assets -%}
            <button type="button" aria-pressed="false" data-gallery-src="{{ asset | asset_url }}" data-gallery-alt="{{ 'lumasela_product.concept_image' | t: number: forloop.index }}"><img src="{{ asset | asset_url }}" alt="{{ 'lumasela_product.concept_image' | t: number: forloop.index }}" width="120" height="120" loading="lazy"></button>
          {%- endfor -%}
        {%- endif -%}
      </div>
      {%- if concept_product -%}<p class="lumasela-gallery-note">{{ 'lumasela_product.concept_note' | t }}</p>{%- endif -%}
      <dialog class="lumasela-gallery-dialog" data-gallery-dialog aria-label="{{ 'lumasela_product.zoom' | t }}">
        <button type="button" data-gallery-close aria-label="{{ 'lumasela_product.close' | t }}">×</button>
        <div data-gallery-zoom-content></div>
      </dialog>
    </div>
    <div class="product-info">
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1>{{ product.title | default: section.settings.demo_title | escape }}</h1>
      <p class="product-price" data-product-price>{%- if product != blank -%}{{ selected_variant.price | money_with_currency }}{%- else -%}{{ 'lumasela_product.price_pending' | t }}{%- endif -%}</p>
      <p class="product-lead">{{ section.settings.intro | escape }}</p>
      {%- if product != blank -%}
        {%- form 'product', product, id: 'LumaselaPreviewProductForm', class: 'lumasela-preview-product__form' -%}
          <select data-variant-data hidden aria-hidden="true" tabindex="-1">
            {%- for variant in product.variants -%}
              <option value="{{ variant.id }}" data-available="{{ variant.available }}" data-price="{{ variant.price | money_with_currency | escape }}" data-image="{% if variant.featured_media.preview_image != blank %}{{ variant.featured_media.preview_image | image_url: width: 1600 }}{% endif %}" data-option1="{{ variant.option1 | escape }}" data-option2="{{ variant.option2 | escape }}" data-option3="{{ variant.option3 | escape }}">{{ variant.title | escape }}</option>
            {%- endfor -%}
          </select>
          <input type="hidden" name="id" value="{{ selected_variant.id }}" data-variant-id>
          {%- for option in product.options_with_values -%}
            <fieldset class="product-option" data-variant-option data-option-position="{{ option.position }}">
              <legend>{{ option.name | escape }}</legend>
              <div class="option-buttons">
                {%- for value in option.values -%}
                  <button type="button" data-option-value="{{ value | escape }}" {% if option.selected_value == value %}class="is-active" aria-pressed="true"{% else %}aria-pressed="false"{% endif %}>{{ value | escape }}</button>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
          {%- if product.options_with_values.size == 0 -%}<p>Product options will appear here when they are configured in Shopify.</p>{%- endif -%}
          {% render 'lumasela-preview-personalisation', demo: false %}
          <p class="lumasela-product-error" data-product-error role="alert" hidden></p>
          <div class="product-purchase-row">
            <div class="quantity-control" data-quantity-control><button type="button" aria-label="Decrease quantity" data-qty-minus>−</button><input type="number" name="quantity" min="1" value="1" aria-label="Quantity" data-qty-input><button type="button" aria-label="Increase quantity" data-qty-plus>+</button></div>
            <button class="button button-dark add-button" type="submit" data-add-to-cart data-label-add="{{ 'products.product.add_to_cart' | t }}" data-label-sold-out="{{ 'products.product.sold_out' | t }}" data-label-unavailable="{{ 'products.product.unavailable' | t }}" {% unless selected_variant.available %}disabled{% endunless %}>{% if selected_variant.available %}Add to cart{% else %}Sold out{% endif %}</button>
          </div>
        {%- endform -%}
      {%- else -%}
        <fieldset class="product-option"><legend>Case Type</legend><div class="option-buttons"><button class="is-active" type="button">Hard PC</button><button type="button">Soft TPU</button><button type="button">Magnetic</button></div></fieldset>
        <fieldset class="product-option"><legend>Phone Model</legend><div class="option-buttons option-buttons-models"><button class="is-active" type="button">iPhone 18 Pro</button><button type="button">iPhone 18 Pro Max</button><button type="button">iPhone 17</button><button type="button">iPhone 17 Pro</button><button type="button">iPhone 17 Pro Max</button><button type="button">iPhone Air</button></div></fieldset>
        <fieldset class="product-option"><legend>Case Color</legend><div class="option-buttons"><button class="is-active" type="button">Clear</button></div></fieldset>
        {% render 'lumasela-preview-personalisation', demo: true %}
        <div class="product-purchase-row"><button class="button button-dark add-button" type="button" disabled>Product not available for purchase</button></div>
      {%- endif -%}
      {%- if concept_product -%}<p class="lumasela-product-disclosure">{{ 'lumasela_product.demo_note' | t }}</p>{%- endif -%}
      <div class="product-accordions" id="details">
        <details open><summary>Product details</summary><div class="rte">{{ product.description | default: section.settings.demo_details }}</div></details>
        {%- if section.settings.shipping_note != blank -%}<details><summary>Shipping &amp; returns</summary><p>{{ section.settings.shipping_note | escape }}</p></details>{%- endif -%}
      </div>
    </div>
  </div>
  <div class="lumasela-mobile-review" data-mobile-review><span data-mobile-price>{{ selected_variant.price | money_with_currency }}</span><a href="#personalise">{{ 'lumasela_product.review' | t }} ↗</a></div>
</section>
{% schema %}
{
  "name": "Lumasela product studio",
  "settings": [
    {"type":"text","id":"demo_title","label":"Preview title when no product is assigned","default":"Signature Clear"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"PERSONALISED CLEAR CASE"},
    {"type":"textarea","id":"intro","label":"Introduction","default":"A clear case with your chosen name set in a quiet, considered typographic style."},
    {"type":"richtext","id":"demo_details","label":"Preview details","default":"<p>Visual concept. Confirm materials and compatible devices before accepting orders.</p>"},
    {"type":"textarea","id":"shipping_note","label":"Shipping and returns note","default":"Review the current shipping and refund policies before ordering."}
  ],
  "presets": [{"name":"Lumasela product studio"}]
}
{% endschema %}
