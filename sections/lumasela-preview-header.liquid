{%- liquid
  assign home_header = false
  if request.page_type == 'index' and section.settings.overlay_home
    assign home_header = true
  endif
  assign product_url = section.settings.shop_link | default: '/products/signature-clear'
-%}
{{ 'lumasela-navigation.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lumasela-navigation.js' | asset_url }}" defer="defer"></script>
<div class="lumasela-navigation{% if home_header %} lumasela-navigation--overlay{% endif %}" data-lumasela-navigation>
  <header class="lumasela-capsule">
    <button type="button" class="lumasela-capsule__menu" aria-label="{{ 'sections.header.menu' | t }}" aria-expanded="false" aria-controls="LumaselaMenu-{{ section.id }}" data-lumasela-menu-open>
      <span class="lumasela-capsule__bars" aria-hidden="true"></span><span class="lumasela-capsule__menu-label">{{ 'sections.header.menu' | t }}</span>
    </button>
    <a class="lumasela-capsule__brand" href="{{ routes.root_url }}">
      {%- if section.settings.logo_image != blank -%}
        {{ section.settings.logo_image | image_url: width: 600 | image_tag: width: 200, class: 'lumasela-capsule__logo', loading: 'eager', alt: section.settings.wordmark }}
      {%- else -%}
        <img class="lumasela-capsule__logo" src="{{ 'lumasela-logo-horizontal.png' | asset_url }}" alt="{{ section.settings.wordmark | escape }}" width="200" height="67" loading="eager">
      {%- endif -%}
    </a>
    <div class="lumasela-capsule__right">
      <a class="lumasela-capsule__customize" href="{{ product_url }}">{{ section.settings.customize_label | escape }}</a>
      <a class="lumasela-capsule__bag" href="{{ routes.cart_url }}" aria-label="{{ 'general.cart.view' | t: count: cart.item_count }}">
        <svg viewBox="0 0 24 26" fill="none" stroke="currentColor" aria-hidden="true"><path d="M4 8h16l1 16H3L4 8ZM8 9V6a4 4 0 0 1 8 0v3"/></svg><span>{{ cart.item_count }}</span>
      </a>
    </div>
  </header>
  <dialog id="LumaselaMenu-{{ section.id }}" class="lumasela-menu" aria-label="{{ 'sections.header.menu' | t }}">
    <div class="lumasela-menu__head">
      <button type="button" class="lumasela-menu__close" data-lumasela-menu-close aria-label="{{ 'accessibility.close' | t }}" autofocus><span aria-hidden="true">×</span><small>{{ 'accessibility.close' | t }}</small></button>
      <a class="lumasela-capsule__brand" href="{{ routes.root_url }}">
        {%- if section.settings.logo_image != blank -%}
          {{ section.settings.logo_image | image_url: width: 600 | image_tag: width: 200, class: 'lumasela-capsule__logo', loading: 'lazy', alt: section.settings.wordmark }}
        {%- else -%}
          <img class="lumasela-capsule__logo" src="{{ 'lumasela-logo-horizontal.png' | asset_url }}" alt="{{ section.settings.wordmark | escape }}" width="200" height="67" loading="lazy">
        {%- endif -%}
      </a>
    </div>
    <div class="lumasela-menu__body">
      <nav class="lumasela-menu__links" aria-label="{{ 'sections.header.menu' | t }}">
        <svg class="lumasela-menu__signature" viewBox="0 0 140 50" aria-hidden="true"><path d="M2 35C25 34 60-4 49 6S26 55 44 39 74 4 67 16 55 43 73 32 92 12 86 25 103 32 114 21M5 45C45 29 100 44 139 27"/></svg>
        <a href="{{ product_url }}"><span aria-hidden="true">01</span>{{ section.settings.shop_label | escape }}</a>
        <a href="{{ section.settings.guide_link | default: '/pages/support?view=customize' }}"><span aria-hidden="true">02</span>{{ section.settings.guide_label | escape }}</a>
        <a href="{{ section.settings.track_link | default: '/pages/support?view=track' }}"><span aria-hidden="true">03</span>{{ section.settings.track_label | escape }}</a>
        <a href="{{ section.settings.faq_link | default: '/pages/support?view=faq' }}"><span aria-hidden="true">04</span>{{ section.settings.faq_label | escape }}</a>
        <a href="{{ section.settings.contact_link | default: '/pages/contact-us' }}"><span aria-hidden="true">05</span>{{ section.settings.contact_label | escape }}</a>
      </nav>
      <div class="lumasela-menu__art"><img src="{{ 'lumasela-n01-navigation-panel.webp' | asset_url }}" alt="" width="1448" height="1086" loading="lazy"></div>
    </div>
    <div class="lumasela-menu__foot"><a href="{{ routes.search_url }}">{{ 'general.search.search' | t }}</a><a href="{{ routes.cart_url }}">{{ 'general.cart.view' | t: count: cart.item_count }}</a></div>
  </dialog>
  <noscript><nav class="lumasela-menu-fallback" aria-label="{{ 'sections.header.menu' | t }}"><a href="{{ product_url }}">{{ section.settings.shop_label | escape }}</a><a href="{{ section.settings.guide_link | default: '/pages/support?view=customize' }}">{{ section.settings.guide_label | escape }}</a><a href="{{ section.settings.track_link | default: '/pages/support?view=track' }}">{{ section.settings.track_label | escape }}</a><a href="{{ section.settings.faq_link | default: '/pages/support?view=faq' }}">{{ section.settings.faq_label | escape }}</a><a href="{{ section.settings.contact_link | default: '/pages/contact-us' }}">{{ section.settings.contact_label | escape }}</a><a href="{{ routes.search_url }}">{{ 'general.search.search' | t }}</a></nav></noscript>
</div>
{% schema %}
{
  "name": "Lumasela preview header",
  "settings": [
    {"type":"text","id":"wordmark","label":"Brand image description","default":"LUMASELA"},
    {"type":"image_picker","id":"logo_image","label":"Custom logo image (optional)"},
    {"type":"checkbox","id":"overlay_home","label":"Overlay homepage hero","default":true},
    {"type":"text","id":"customize_label","label":"Customize button label","default":"Customize yours"},
    {"type":"text","id":"shop_label","label":"Shop label","default":"Shop"},
    {"type":"url","id":"shop_link","label":"Product destination"},
    {"type":"text","id":"guide_label","label":"Guide label","default":"How to Customize"},
    {"type":"url","id":"guide_link","label":"Guide destination"},
    {"type":"text","id":"track_label","label":"Order tracking label","default":"Track Your Order"},
    {"type":"url","id":"track_link","label":"Order tracking destination"},
    {"type":"text","id":"faq_label","label":"FAQ label","default":"FAQ"},
    {"type":"url","id":"faq_link","label":"FAQ destination"},
    {"type":"text","id":"contact_label","label":"Contact label","default":"Contact Us"},
    {"type":"url","id":"contact_link","label":"Contact destination"}
  ],
  "presets": [{"name":"Lumasela preview header"}]
}
{% endschema %}
