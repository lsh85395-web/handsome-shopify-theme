<nav class="hs-category-links page-width" aria-label="{{ section.settings.label | escape }}" id="hs-category-{{ section.id }}">
  {% for block in section.blocks %}
    <a class="hs-category-links__item" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{{ block.settings.title | escape }}</a>
  {% endfor %}
</nav>
{% schema %}
{
  "name":"Handsome category links",
  "settings":[{"type":"text","id":"label","label":"Accessible label","default":"Browse categories"}],
  "blocks":[{"type":"link","name":"Category","settings":[{"type":"text","id":"title","label":"Label","default":"All shoes"},{"type":"url","id":"link","label":"Link"}]}],
  "max_blocks":6,
  "presets":[{"name":"Handsome category links","blocks":[{"type":"link"},{"type":"link"}]}]
}
{% endschema %}
