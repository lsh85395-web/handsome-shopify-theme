{{ 'lumasela-home-sections.css' | asset_url | stylesheet_tag }}
<section class="lumasela-home-faq lumasela-section color-{{ section.settings.color_scheme }}" aria-labelledby="HomeFAQ-{{ section.id }}">
  <div class="page-width lumasela-home-faq__inner">
    <header><p class="lumasela-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="HomeFAQ-{{ section.id }}" class="lumasela-display lumasela-display--section">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.link != blank -%}<a class="lumasela-text-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} <span aria-hidden="true">↗</span></a>{%- endif -%}
    </header>
    <div>
      {%- for block in section.blocks -%}
        <details class="lumasela-home-faq__item" {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}<span aria-hidden="true">+</span></summary><div class="rte">{{ block.settings.answer }}</div></details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lumasela home FAQ",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "FAQ link label",
      "default": "Read all FAQs"
    },
    {
      "type": "url",
      "id": "link",
      "label": "FAQ link"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lumasela home FAQ"
    }
  ]
}
{% endschema %}
