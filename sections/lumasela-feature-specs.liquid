<section
  class="lumasela-feature-specs color-{{ section.settings.color_scheme }} gradient"
  aria-labelledby="LumaselaFeatures-{{ section.id }}"
>
  <div class="page-width lumasela-feature-specs__inner">
    <header class="lumasela-feature-specs__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="lumasela-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 id="LumaselaFeatures-{{ section.id }}" class="lumasela-display lumasela-display--section">
        {{ section.settings.heading | escape }}
      </h2>
      {%- if section.settings.text != blank -%}
        <div class="lumasela-section-heading__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </header>

    <div class="lumasela-feature-specs__grid" role="list">
      {%- for block in section.blocks -%}
        <article class="lumasela-feature-specs__item" role="listitem" {{ block.shopify_attributes }}>
          <span>{{ forloop.index | prepend: '0' }}</span>
          <h3>{{ block.settings.title | escape }}</h3>
          <div class="rte">{{ block.settings.text }}</div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lumasela feature specs",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PRODUCT DETAILS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Know what you are choosing." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Keep the information customers need close to the product, and replace every demo statement with verified production data before launch.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Choose the exact device" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Select the exact phone model shown in the product options.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lumasela feature specs",
      "blocks": [
        { "type": "feature", "settings": { "title": "Choose the exact device", "text": "<p>Select the exact phone model shown in the product options.</p>" } },
        { "type": "feature", "settings": { "title": "Preview the signature", "text": "<p>Review the name, style, colour and position before adding it to cart.</p>" } },
        { "type": "feature", "settings": { "title": "Check verified details", "text": "<p>Use the product description for confirmed materials, fit and care information.</p>" } }
      ]
    }
  ]
}
{% endschema %}
