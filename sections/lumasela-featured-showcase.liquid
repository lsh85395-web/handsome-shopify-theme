{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>

<section
  class="lumasela-products color-{{ section.settings.color_scheme }} gradient"
  aria-labelledby="LumaselaProducts-{{ section.id }}"
>
  <div class="page-width">
    <header class="lumasela-products__header">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="lumasela-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 id="LumaselaProducts-{{ section.id }}" class="lumasela-display lumasela-display--section">
          {{ section.settings.heading | escape }}
        </h2>
      </div>
      {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
        <a class="lumasela-text-link" href="{{ section.settings.collection.url }}">
          {{ section.settings.view_all_label | default: 'View all' | escape }} →
        </a>
      {%- endif -%}
    </header>

    <ul class="lumasela-products__track" role="list">
      {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          <li class="lumasela-products__item">
            {% render 'card-product',
              card_product: product,
              media_aspect_ratio: 'square',
              image_shape: 'default',
              lazy_load: true,
              show_secondary_image: true,
              show_vendor: false,
              show_rating: false,
              section_id: section.id,
              quick_add: 'standard',
              product_view_context: 'collection'
            %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign fallback_file = 'lumasela-iphone18pro-silver-clear-standard-v1.jpg'
            assign fallback_width = 1024
            assign fallback_height = 1536
            case block.settings.fallback_asset
              when 'customizer'
                assign fallback_file = 'lumasela-customizer-preview-v1.jpg'
                assign fallback_width = 1122
                assign fallback_height = 1402
              when 'detail'
                assign fallback_file = 'lumasela-detail-macro-v1.jpg'
                assign fallback_width = 1672
                assign fallback_height = 941
              when 'desk'
                assign fallback_file = 'lumasela-desk-lifestyle-iphone18pro-silver-clear-v1.jpg'
                assign fallback_width = 1672
                assign fallback_height = 941
            endcase
            assign image_alt = block.settings.image.alt | default: block.settings.image_alt | default: block.settings.title
          -%}
          <li class="lumasela-products__item" {{ block.shopify_attributes }}>
            <article class="lumasela-demo-product">
              <div class="lumasela-demo-product__media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1000
                    | image_tag:
                      widths: '360, 540, 720, 900, 1000',
                      sizes: '(min-width: 990px) 25vw, 78vw',
                      loading: 'lazy',
                      class: 'lumasela-demo-product__image',
                      alt: image_alt
                  }}
                {%- else -%}
                  <img
                    class="lumasela-demo-product__image"
                    src="{{ fallback_file | asset_url }}"
                    alt="{{ image_alt | escape }}"
                    width="{{ fallback_width }}"
                    height="{{ fallback_height }}"
                    loading="lazy"
                  >
                {%- endif -%}
                <span class="lumasela-demo-product__badge">DEMO</span>
              </div>
              <div class="lumasela-demo-product__content">
                <p class="lumasela-demo-product__meta">{{ block.settings.meta | escape }}</p>
                <h3>{{ block.settings.title | escape }}</h3>
                <p>{{ block.settings.text | escape }}</p>
                <span class="lumasela-demo-product__status">Preview only · connect a Shopify product</span>
              </div>
            </article>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if request.design_mode -%}
      {%- if section.settings.collection == blank or section.settings.collection.products_count == 0 -%}
        <p class="lumasela-products__setup">
          {{ section.settings.setup_note | escape }}
        </p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Lumasela featured",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SHOP THE EDIT" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Designed to become yours." },
    { "type": "collection", "id": "collection", "label": "Shopify collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "label": "Products to show", "default": 4 },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "Shop all cases" },
    { "type": "text", "id": "setup_note", "label": "Empty collection note", "default": "Demo cards are shown until a published Shopify collection is selected in the theme editor." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "demo_product",
      "name": "Demo product card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "fallback_asset",
          "label": "Included fallback image",
          "options": [
            { "value": "product", "label": "Clear case" },
            { "value": "customizer", "label": "Customizer" },
            { "value": "detail", "label": "Detail" },
            { "value": "desk", "label": "Desk" }
          ],
          "default": "product"
        },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Demo Lumasela phone case" },
        { "type": "text", "id": "meta", "label": "Meta label", "default": "DEMO PRODUCT" },
        { "type": "text", "id": "title", "label": "Title", "default": "Signature Clear Case" },
        { "type": "text", "id": "text", "label": "Description", "default": "Replace with verified product data before launch." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lumasela featured",
      "blocks": [
        { "type": "demo_product", "settings": { "fallback_asset": "product", "meta": "DEMO · PERSONALIZED", "title": "Signature Clear Case" } },
        { "type": "demo_product", "settings": { "fallback_asset": "customizer", "meta": "DEMO · MINIMAL", "title": "Pure Clear Case" } },
        { "type": "demo_product", "settings": { "fallback_asset": "detail", "meta": "DEMO · DETAIL", "title": "Camera Detail Case" } },
        { "type": "demo_product", "settings": { "fallback_asset": "desk", "meta": "DEMO · GIFT", "title": "Personal Gift Case" } }
      ]
    }
  ]
}
{% endschema %}
