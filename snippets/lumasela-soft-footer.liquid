{% doc %}
  Lumasela footer displaying only policies with saved content.
{% enddoc %}
<footer class="site-footer"><div class="site-footer-brand"><a href="{{ routes.root_url }}" aria-label="{{ 'lumasela_soft.shell.t28' | t }}"><img class="site-footer-logo" src="{{ 'lumasela-logo-horizontal.png' | asset_url }}" alt="{{ 'lumasela_soft.shell.t29' | t }}" width="264" height="60"></a><p>{{ 'lumasela_soft.shell.t16' | t }}</p></div><div class="site-footer-columns"><nav aria-label="{{ 'lumasela_soft.shell.t30' | t }}"><h2>{{ 'lumasela_soft.shell.t17' | t }}</h2><a href="{{ all_products['signature-clear'].url | default: '/products/signature-clear' }}">{{ 'lumasela_soft.shell.t18' | t }}</a><a href="{{ routes.root_url }}#styles">{{ 'lumasela_soft.shell.t19' | t }}</a><a href="{{ routes.root_url }}#story">{{ 'lumasela_soft.shell.t20' | t }}</a></nav><nav aria-label="{{ 'lumasela_soft.shell.t31' | t }}"><h2>{{ 'lumasela_soft.shell.t21' | t }}</h2><a href="{{ routes.root_url }}#how-it-works">{{ 'lumasela_soft.shell.t22' | t }}</a><a href="{{ routes.root_url }}#faq">{{ 'lumasela_soft.shell.t23' | t }}</a><a href="{{ pages['contact-us'].url }}">{{ 'lumasela_soft.shell.t24' | t }}</a><a href="{{ routes.account_url }}">{{ 'lumasela_soft.shell.t25' | t }}</a></nav><nav aria-label="{{ 'lumasela_soft.shell.t32' | t }}"><h2>{{ 'lumasela_soft.shell.t26' | t }}</h2>{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</nav></div></footer>