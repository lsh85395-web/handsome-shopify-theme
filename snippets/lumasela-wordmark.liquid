{% doc %}
  Renders the supplied LUMASELA logo in the standard Shopify header fallback.
{% enddoc %}

<span class="lumasela-wordmark" role="img" aria-label="{{ settings.lumasela_brand_name | default: 'Lumasela' | escape }}">
  <img src="{{ 'lumasela-logo-horizontal.png' | asset_url }}" alt="" width="200" height="40" loading="eager" style="display:block;width:200px;max-width:100%;height:40px;object-fit:cover;object-position:center">
</span>
